{
  "extends": "stylelint-config-standard",
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "custom-variant",
          "theme",
          "tailwind",
          "tailwind-base",
          "tailwind-components",
          "tailwind-utilities",
          "layer"
        ]
      }
    ],
    "at-rule-prelude-no-invalid": [
      true,
      {
        "ignoreAtRules": ["apply"]
      }
    ],
    "import-notation": "string"
  }
}
