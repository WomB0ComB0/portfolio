{
  "extends": ["config:recommended", ":semanticCommits"],
  "timezone": "America/New_York",
  "osvVulnerabilityAlerts": true,
  "platformAutomerge": true,
  "prHourlyLimit": 6,
  "rangeStrategy": "auto",
  "labels": ["dependencies"],
  "dependencyDashboard": {
    "enabled": true
  },
  "enabledManagers": ["npm", "bun", "github-actions", "dockerfile", "nvm"],
  "packageRules": [
    {
      "description": "Action updates automerge, so a release must be 3 days old before Renovate opens the PR; strict filtering keeps a newer release from being picked before then",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "devDependency updates automerge, so a release must be 3 days old before Renovate opens the PR; strict filtering keeps a newer release from being picked before then",
      "matchManagers": ["npm", "bun"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Node moves in one PR: package.json engines (which Vercel follows) and .nvmrc (which the workflows read) change together",
      "matchDatasources": ["node-version"],
      "groupName": "node"
    },
    {
      "matchManagers": ["npm", "bun"],
      "groupName": "types",
      "matchPackageNames": ["/^@types\\//"]
    },
    {
      "matchManagers": ["npm", "bun"],
      "groupName": "linting",
      "matchPackageNames": ["/^eslint/", "/^@eslint\\//", "/^prettier/"]
    },
    {
      "matchManagers": ["npm", "bun"],
      "groupName": "logtail",
      "matchPackageNames": ["/^@logtail\\//"]
    },
    {
      "description": "The @opentelemetry/* packages pin exact versions of each other, so they move in one PR",
      "matchManagers": ["npm", "bun"],
      "groupName": "opentelemetry-js",
      "matchPackageNames": ["/^@opentelemetry\\//"]
    },
    {
      "matchManagers": ["npm", "bun"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    },
    {
      "matchManagers": ["npm", "bun"],
      "matchPackageNames": ["elysia-rate-limit"],
      "allowedVersions": "<5.0.0"
    },
    {
      "description": "@pierre/diffs 1.6.3 was published with unresolved catalog:/workspace: specifiers and cannot be installed; skip it so the override moves straight to the next good release",
      "matchManagers": ["npm", "bun"],
      "matchPackageNames": ["@pierre/diffs"],
      "allowedVersions": "!/^1\\.6\\.3$/"
    },
    {
      "matchManagers": ["npm", "bun"],
      "matchDatasources": ["npm"],
      "separateMajorMinor": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  }
}
