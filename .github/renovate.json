{
  "extends": ["config:recommended", ":semanticCommits"],
  "timezone": "America/New_York",
  "osvVulnerabilityAlerts": true,
  "platformAutomerge": true,
  "prHourlyLimit": 6,
  "rangeStrategy": "auto",
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "enabledManagers": ["npm", "bun", "github-actions", "dockerfile"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": ["npm", "bun"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["npm", "bun"],
      "groupName": "types",
      "matchPackageNames": ["/^@types\\//"]
    },
    {
      "matchManagers": ["npm", "bun"],
      "groupName": "linting",
      "matchPackageNames": ["/^eslint/", "/^@eslint\\//", "/^prettier/"]
    },
    {
      "matchManagers": ["npm", "bun"],
      "groupName": "logtail",
      "matchPackageNames": ["/^@logtail\\//"]
    },
    {
      "description": "The @opentelemetry/* packages pin exact versions of each other, so they move in one PR",
      "matchManagers": ["npm", "bun"],
      "groupName": "opentelemetry-js",
      "matchPackageNames": ["/^@opentelemetry\\//"]
    },
    {
      "matchManagers": ["npm", "bun"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    },
    {
      "matchManagers": ["npm", "bun"],
      "matchPackageNames": ["elysia-rate-limit"],
      "allowedVersions": "<5.0.0"
    },
    {
      "description": "deepmerge 4.2.0 through 4.3.1 are affected by GHSA-gcqx-w48m-w2h4 and no fixed release exists yet, so the security override stays on 4.1.2",
      "matchManagers": ["npm", "bun"],
      "matchPackageNames": ["deepmerge"],
      "allowedVersions": "<4.2.0"
    },
    {
      "description": "@pierre/diffs 1.6.3 was published with unresolved catalog:/workspace: specifiers and cannot be installed; skip it so the override moves straight to the next good release",
      "matchManagers": ["npm", "bun"],
      "matchPackageNames": ["@pierre/diffs"],
      "allowedVersions": "!/^1\\.6\\.3$/"
    },
    {
      "matchManagers": ["npm", "bun"],
      "matchDatasources": ["npm"],
      "separateMajorMinor": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  }
}
